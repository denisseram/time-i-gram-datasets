# Masterpieces of the novelists of `writers.rq`: their notable works (P800) that are literary works, have articles
# in at least 30 Wikipedias (sitelinks) and were first published (the earliest P577, the first edition) in the
# writer's lifetime or up to 10 years after their death; with the writer's birth (the anchor of the relative axes).
SELECT ?writer ?writerLabel ?birth ?death ?work ?workLabel ?sitelinks (MIN(?date) AS ?published) WHERE {
  VALUES ?writer { wd:Q36322 wd:Q47152 wd:Q127332 wd:Q80137 wd:Q9711 wd:Q33977 wd:Q5686 wd:Q43444 wd:Q131333 wd:Q4985
                   wd:Q991 wd:Q7243 wd:Q7245 wd:Q132805 wd:Q7199 wd:Q37030 wd:Q6882 wd:Q40909 wd:Q905 wd:Q93354
                   wd:Q38392 wd:Q23434 wd:Q5878 wd:Q72334 }
  ?writer wdt:P569 ?birth ;
          wdt:P570 ?death ;
          wdt:P800 ?work .
  ?work wdt:P31/wdt:P279* wd:Q7725634 ;
        wdt:P577 ?date ;
        wikibase:sitelinks ?sitelinks .
  FILTER(?sitelinks >= 30)
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en,fr". }
}
GROUP BY ?writer ?writerLabel ?birth ?death ?work ?workLabel ?sitelinks
HAVING(YEAR(MIN(?date)) <= YEAR(?death) + 10)
ORDER BY ?birth ?published
